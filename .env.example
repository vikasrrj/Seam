# PostgreSQL and Kafka defaults for docker-compose.yml
SOURCE_SQL_DSN='postgres://postgres:postgres@localhost:5433/source?sslmode=disable'
SOURCE_REPLICATION_DSN='postgres://postgres:postgres@localhost:5433/source?sslmode=disable&replication=database'
DEST_SQL_DSN='postgres://postgres:postgres@localhost:5434/dest?sslmode=disable'
SEAM_SOURCE_SLOT=seam_slot
SEAM_SOURCE_PUBLICATION=seam_pub
SEAM_SOURCE_TABLE=accounts
SEAM_GENERATION=gen:0
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=seam.accounts

# Snowflake. Keep real credentials only in an ignored local file.
SNOWFLAKE_DSN=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=SEAM
SNOWFLAKE_INTERNAL_SCHEMA=SEAM_INTERNAL
SNOWFLAKE_LIVE_TABLE=ACCOUNTS
SNOWFLAKE_SHADOW_TABLE=ACCOUNTS_SHADOW
SEAM_STREAM_ID=seam-accounts
SEAM_BACKFILL_JOB_ID=snowflake-backfill
SEAM_BACKFILL_ATTEMPT=attempt-1
